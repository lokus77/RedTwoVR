+/// OpenXR (red_two): the adapter the headset is connected to. Set before aurora_initialize;
+/// the adapter request then asks Dawn (D3D12/D3D11) for the adapter with this LUID.
+void set_adapter_luid(uint32_t lowPart, int32_t highPart) noexcept;
+
+/// OpenXR (red_two): invoked on the render worker for each frame of the primary target, once
+/// its commands are submitted and before it is presented, with the frame's picture (the XFB
+/// texture the window shows, at the internal resolution; null in frames without one) and the
+/// window's own texture with ImGui drawn over it (null unless the surface can be sampled:
+/// with set_adapter_luid it is asked for). Both can be sampled and are borrowed for the call.
+using PresentHook = void (*)(const wgpu::Device& device, const wgpu::Queue& queue, const wgpu::Texture& source,
+                             const wgpu::Texture& window, void* userdata);
+void set_present_hook(PresentHook hook, void* userdata) noexcept;
+
 } // namespace aurora::gfx
