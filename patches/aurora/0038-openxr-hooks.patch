   }
+  // OpenXR: the frame's picture, and the window's (with ImGui) when it can be sampled
+  if (request.primary) {
+    if (const auto hook = g_presentHook.load(std::memory_order_acquire)) {
+      ZoneScopedN("Present hook");
+      const bool sampled = (snapshot.usage & wgpu::TextureUsage::TextureBinding) != wgpu::TextureUsage::None;
+      hook(webgpu::g_device, webgpu::g_queue, request.source.texture,
+           sampled ? surfaceTexture.texture : wgpu::Texture{}, g_presentHookData.load(std::memory_order_relaxed));
+    }
+  }
   wgpu::ConvertibleStatus status = wgpu::Status::Error;
   {
     ZoneScopedN("Present");
@@ -561,12 +580,24 @@ bool bind_xfb_surface(wgpu::Surface&& surface, const AuroraSurfaceDesc& desc) {
 
     const auto size = desc.type == AURORA_SURFACE_SDL_MANAGED ? window::refresh_window_size()
                                                               : target_size(desc.width, desc.height, desc.scale);
+    // OpenXR: the headset shows the window's picture while ImGui is up (sampled)
+    wgpu::TextureUsage usage = wgpu::TextureUsage::RenderAttachment;
+    if (webgpu::g_adapterLuidSet) {
+      wgpu::SurfaceCapabilities caps;
+      if (surface.GetCapabilities(webgpu::g_adapter, &caps) == wgpu::Status::Success &&
+          (caps.usages & wgpu::TextureUsage::TextureBinding) != wgpu::TextureUsage::None) {
+        usage |= wgpu::TextureUsage::TextureBinding;
+      } else {
+        Log.warn("Primary XFB: the window cannot be sampled; the headset will not show the menus");
+      }
+    }
     next = create_present_target({
         .label = "Primary XFB",
         .surface = std::move(surface),
         .width = size.native_fb_width,
         .height = size.native_fb_height,
         .scale = size.scale,
+        .usage = usage,
         .preferredFormat = color_format(),
         .vsync = webgpu::vsync_enabled(),
     });
