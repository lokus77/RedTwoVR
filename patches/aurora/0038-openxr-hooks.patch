 namespace aurora::gfx {
+// OpenXR (red_two): set_present_hook
+static std::atomic<PresentHook> g_presentHook{nullptr};
+static std::atomic<void*> g_presentHookData{nullptr};
+
+void set_present_hook(PresentHook hook, void* userdata) noexcept {
+  g_presentHookData.store(userdata, std::memory_order_relaxed);
+  g_presentHook.store(hook, std::memory_order_release);
+}
