diff --git a/lib/gfx/present_target.cpp b/lib/gfx/present_target.cpp
index 03113c6..28ec9e8 100644
--- a/lib/gfx/present_target.cpp
+++ b/lib/gfx/present_target.cpp
@@ -475,7 +475,9 @@ void submit(const Request& request) {
     if (const auto hook = g_presentHook.load(std::memory_order_acquire)) {
       ZoneScopedN("Present hook");
       const bool sampled = (snapshot.usage & wgpu::TextureUsage::TextureBinding) != wgpu::TextureUsage::None;
-      hook(webgpu::g_device, webgpu::g_queue, request.source.texture, request.stereoRight,
+      // (stereo: the eyes at the size they were drawn at, not the window's)
+      hook(webgpu::g_device, webgpu::g_queue, request.stereoLeft ? request.stereoLeft : request.source.texture,
+           request.stereoRight,
            sampled ? surfaceTexture.texture : wgpu::Texture{}, request.frame,
            g_presentHookData.load(std::memory_order_relaxed));
     }
diff --git a/lib/gfx/present_target.hpp b/lib/gfx/present_target.hpp
index dd0a182..6357c3e 100644
--- a/lib/gfx/present_target.hpp
+++ b/lib/gfx/present_target.hpp
@@ -28,6 +28,7 @@ struct Request {
   TargetSnapshot target;
   webgpu::TextureWithSampler source;
