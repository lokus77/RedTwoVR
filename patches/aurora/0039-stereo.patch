+  // (a composed XFB: the frame is the XFB's lines, drawn a band at a time)
+  const float frameH = g_gxState.xfbHeight != 0 ? static_cast<float>(g_gxState.xfbHeight) : static_cast<float>(fbHeight);
+  const float frameW = static_cast<float>(fbWidth);
