+static Mat4x4<float> stereo_projection(const Mat4x4<float>& game, const GXState::StereoEye& eye,
+                                       const StereoFit& fit) noexcept {
+  const float tl = eye.tan[0], tr = eye.tan[1], td = eye.tan[2], tu = eye.tan[3];
+  const float q[4][4] = {
+      {fit.kx * 2.f / (tr - tl), 0.f, fit.kx * (tr + tl) / (tr - tl) + fit.offX, 0.f},
+      {0.f, fit.ky * 2.f / (tu - td), fit.ky * (tu + td) / (tu - td) + fit.offY, 0.f},
+      {game.m2[0], game.m2[1], game.m2[2], game.m2[3]},
+      {game.m3[0], game.m3[1], game.m3[2], game.m3[3]},
+  };
+  const float m[4][4] = {
+      {eye.view[0], eye.view[1], eye.view[2], eye.view[3]},
+      {eye.view[4], eye.view[5], eye.view[6], eye.view[7]},
+      {eye.view[8], eye.view[9], eye.view[10], eye.view[11]},
+      {0.f, 0.f, 0.f, 1.f},
+  };
+  Mat4x4<float> out{};
+  Vec4<float>* rows[4] = {&out.m0, &out.m1, &out.m2, &out.m3};
+  for (int i = 0; i < 4; ++i) {
+    for (int j = 0; j < 4; ++j) {
+      float v = 0.f;
+      for (int k = 0; k < 4; ++k) {
